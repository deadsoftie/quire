{
  "name": "@quire/desktop",
  "productName": "Quire",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first LaTeX editor",
  "author": "deadsoftie <rahulnair1229@gmail.com>",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@quire/client": "workspace:*",
    "archiver": "^8.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.deadsoftie.quire",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.test.js"
    ],
    "extraResources": [
      {
        "from": "../../target/release/quire-sidecar",
        "to": "quire-sidecar"
      },
      {
        "from": "../../bundles/core",
        "to": "bundles/core"
      },
      {
        "from": "../../bundles/manifest.json",
        "to": "bundles/manifest.json"
      },
      {
        "from": "../../templates",
        "to": "templates",
        "filter": [
          "*.tex"
        ]
      },
      {
        "from": "../../packages/ui/dist",
        "to": "ui"
      }
    ],
    "icon": "assets/icon.png",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/quire-sidecar"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "publish": {
      "provider": "github",
      "owner": "deadsoftie",
      "repo": "quire"
    }
  }
}
