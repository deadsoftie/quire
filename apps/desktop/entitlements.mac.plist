<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- electron-builder's own default template (app-builder-lib/templates/entitlements.mac.plist),
         copied in explicitly rather than relying on its implicit default so it's visible/editable here.
         allow-jit and allow-unsigned-executable-memory are Electron/V8's own requirements under hardened
         runtime; disable-library-validation covers quire-sidecar spawning system TeX/biber as child
         processes. See https://github.com/electron/electron-notarize#prerequisites -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
