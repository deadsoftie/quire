// LaTeX grammar for CodeMirror 6, compiled by @lezer/generator (see
// vite.config.ts's `lezer()` plugin -- this file is a build input, not
// hand-transpiled output).
//
// Environment/math-mode dispatch is name-based, not nesting-based: \begin
// and \end aren't required to carry matching names at the grammar level
// (Environment/MathEnvironment/VerbatimEnvironment are three separate
// productions selected by which specialized name token follows \begin{),
// so a mismatched \begin{foo}...\end{bar} still parses (as whichever kind
// \begin{foo} implies) rather than erroring -- this is a syntax highlighter,
// not a validator.
//
// Math mode does not literally nest ($ inside $ is invalid LaTeX and not
// representable here); the one legitimate way back into a math/text
// distinction is a text-mode-switching command (\text, \mbox, ...), whose
// brace argument is parsed as ordinary `content` again -- which is how
// `$a + \text{$b$}$` produces a nested InlineMath.

@top Document { content* }

@skip { space | Comment }

content {
  Command |
  TextCommand TextArg |
  Environment |
  MathEnvironment |
  VerbatimEnvironment |
  Group |
  InlineMath |
  DisplayMathDollar |
  DisplayMathBracket |
  InlineMathParen |
  Text
}

// Same as `content`, minus the things that only make sense in text mode
// (nested environments, argument-taking groups aren't distinguished from
// plain grouping in math, so `Group` is `MathGroup` instead).
mathContent {
  Command |
  TextCommand TextArg |
  MathGroup |
  Text
}

Group { "{" content* "}" }
MathGroup { "{" mathContent* "}" }
TextArg { "{" content* "}" }

InlineMath { dollar mathContent* dollar }
DisplayMathDollar { dollarDollar mathContent* dollarDollar }
DisplayMathBracket { MathBracketOpen mathContent* MathBracketClose }
InlineMathParen { MathParenOpen mathContent* MathParenClose }

Environment { BeginKw "{" EnvName "}" content* EndKw "{" EnvName "}" }
MathEnvironment { BeginKw "{" MathEnvName "}" mathContent* EndKw "{" MathEnvName "}" }
VerbatimEnvironment { BeginKw "{" VerbatimEnvName "}" VerbatimBody? EndKw "{" VerbatimEnvName "}" }

@tokens {
  space { std.whitespace+ }

  // `%` starts a comment to end of line; `\%` (escaped) is a Command token
  // instead (backslash binds the `%` first), so this never fires for it.
  Comment { "%" ![\n]* }

  Command { "\\" ($[a-zA-Z]+ | ![a-zA-Z]) }

  dollar { "$" }
  dollarDollar { "$$" }

  EnvName { $[a-zA-Z]+ "*"? }

  Text { ![\\{}$%\n\r\t ]+ }

  "{"
  "}"

  @precedence { Text, space }
}

// Environment/command names and math delimiters are carved out of the
// generic Command/EnvName tokens by exact text, rather than given their
// own token rules -- two token rules matching the same characters (e.g. a
// literal "\[" token alongside Command's generic "\" + non-letter branch)
// is a lexical conflict Lezer can't resolve on its own.
TextCommand { @specialize<Command, "\\text" | "\\mbox" | "\\textrm" | "\\textbf" | "\\textit" | "\\textsf" | "\\texttt" | "\\emph" | "\\textnormal" | "\\intertext" | "\\caption"> }

BeginKw { @specialize<Command, "\\begin"> }
EndKw { @specialize<Command, "\\end"> }

MathBracketOpen { @specialize<Command, "\\["> }
MathBracketClose { @specialize<Command, "\\]"> }
MathParenOpen { @specialize<Command, "\\("> }
MathParenClose { @specialize<Command, "\\)"> }

MathEnvName { @specialize<EnvName, "equation" | "equation*" | "align" | "align*" | "gather" | "gather*" | "multline" | "multline*" | "eqnarray" | "eqnarray*" | "math" | "displaymath" | "flalign" | "flalign*"> }
VerbatimEnvName { @specialize<EnvName, "verbatim" | "verbatim*" | "lstlisting" | "minted"> }

// Consumes raw content inside \begin{verbatim}/\begin{lstlisting}/... up
// to (not including) the next literal "\end{" -- see tokens.ts. Doesn't
// verify the name inside that "\end{...}" matches; good enough for
// highlighting, not meant to catch mismatched verbatim environments.
@external tokens verbatimTokenizer from "./tokens" { VerbatimBody }
