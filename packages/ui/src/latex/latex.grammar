// LaTeX grammar for CodeMirror 6, compiled by `pnpm generate` (scripts/generate-latex-parser.mjs) into parser.ts/parser.terms.ts -- not hand-transpiled.
//
// Environment/math dispatch is name-based, not nesting-based, so a mismatched \begin{foo}...\end{bar} still parses -- this is a highlighter, not a validator.
//
// Math doesn't literally nest; \text{$b$}-style nested math works because \text's brace argument is parsed as ordinary `content` again.

@top Document { content* }

@skip { space | Comment }

content {
  Command |
  TextCommand TextArg |
  Environment |
  MathEnvironment |
  VerbatimEnvironment |
  Group |
  InlineMath |
  DisplayMathDollar |
  DisplayMathBracket |
  InlineMathParen |
  Text
}

// Same as `content` minus text-mode-only constructs; `Group` becomes `MathGroup`.
mathContent {
  Command |
  TextCommand TextArg |
  MathGroup |
  Text
}

Group { "{" content* "}" }
MathGroup { "{" mathContent* "}" }
TextArg { "{" content* "}" }

InlineMath { dollar mathContent* dollar }
DisplayMathDollar { dollarDollar mathContent* dollarDollar }
DisplayMathBracket { MathBracketOpen mathContent* MathBracketClose }
InlineMathParen { MathParenOpen mathContent* MathParenClose }

Environment { BeginKw "{" EnvName "}" content* EndKw "{" EnvName "}" }
MathEnvironment { BeginKw "{" MathEnvName "}" mathContent* EndKw "{" MathEnvName "}" }
VerbatimEnvironment { BeginKw "{" VerbatimEnvName "}" VerbatimBody? EndKw "{" VerbatimEnvName "}" }

@tokens {
  space { std.whitespace+ }

  // `\%` is a Command token instead (backslash binds first), so this never fires for it.
  Comment { "%" ![\n]* }

  Command { "\\" ($[a-zA-Z]+ | ![a-zA-Z]) }

  dollar { "$" }
  dollarDollar { "$$" }

  EnvName { $[a-zA-Z]+ "*"? }

  Text { ![\\{}$%\n\r\t ]+ }

  "{"
  "}"

  @precedence { Text, space }
}

// Specialized by exact text out of Command/EnvName, not given their own token rules -- two rules matching the same characters is a lexical conflict Lezer can't resolve.
TextCommand { @specialize<Command, "\\text" | "\\mbox" | "\\textrm" | "\\textbf" | "\\textit" | "\\textsf" | "\\texttt" | "\\emph" | "\\textnormal" | "\\intertext" | "\\caption"> }

BeginKw { @specialize<Command, "\\begin"> }
EndKw { @specialize<Command, "\\end"> }

MathBracketOpen { @specialize<Command, "\\["> }
MathBracketClose { @specialize<Command, "\\]"> }
MathParenOpen { @specialize<Command, "\\("> }
MathParenClose { @specialize<Command, "\\)"> }

MathEnvName { @specialize<EnvName, "equation" | "equation*" | "align" | "align*" | "gather" | "gather*" | "multline" | "multline*" | "eqnarray" | "eqnarray*" | "math" | "displaymath" | "flalign" | "flalign*"> }
VerbatimEnvName { @specialize<EnvName, "verbatim" | "verbatim*" | "lstlisting" | "minted"> }

// Consumes raw content up to the next literal "\end{" -- see tokens.ts. Doesn't verify the name matches.
@external tokens verbatimTokenizer from "./tokens" { VerbatimBody }
